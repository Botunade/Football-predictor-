# Multi-Sport Predictor V4 Configuration
# Copy this file to .env and fill in your values

# ============================================
# API-Sports Configuration (Required)
# ============================================
# Get your free API key at: https://dashboard.api-football.com/
API_KEY=your_api_sports_key_here

# ============================================
# Model Settings (Optional)
# ============================================
# Number of trees in XGBoost model
MODEL_N_ESTIMATORS=200
# Learning rate for model training
MODEL_LR=0.05
# Maximum tree depth
MODEL_MAX_DEPTH=5
# Random state for reproducibility
MODEL_RANDOM_STATE=42

# ============================================
# Scraper Settings (Optional)
# ============================================
# Use headless browser (set to false for debugging)
SCRAPER_HEADLESS=true
# Scraping timeout in milliseconds
SCRAPER_TIMEOUT=60000
# Maximum retry attempts
SCRAPER_MAX_RETRIES=3

# ============================================
# Prediction Settings (Optional)
# ============================================
# Minimum value threshold for value bets (default: 0.08 = 8%)
MIN_VALUE_THRESHOLD=0.08
# Output format: json or csv
OUTPUT_FORMAT=json

# ============================================
# Deprecated (V3 -> V4 Changes)
# ============================================
# TELEGRAM_TOKEN - No longer used (removed in V4)
# CHAT_ID - No longer used (removed in V4)
# ODDS_API_KEY - No longer used (removed in V4)

# ============================================
# Web Scraping URLs (Optional)
# ============================================
# Comma-separated list of scraping sources
FOOTBALL_SCRAPE_URLS=https://fbref.com/,https://understat.com/
BASKETBALL_SCRAPE_URLS=https://www.basketball-reference.com/
HOCKEY_SCRAPE_URLS=https://www.hockey-reference.com/